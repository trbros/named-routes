---
import { route } from "../routes.generated";
const links = [
  { label: "users.$id", href: route("users.$id", { id: 42 }) },
  { label: "docs.$slug", href: route("docs.$slug", { slug: ["guide", "install"] }) },
  { label: "docs.$slug (empty)", href: route("docs.$slug") },
];
---
<html lang="en">
  <body style="font-family: system-ui; max-width: 640px; margin: 48px auto">
    <h1>NamedRoutes · Astro</h1>
    <ul>{links.map((link) => <li><a href={link.href}>{link.label}</a> → <code>{link.href}</code></li>)}</ul>
  </body>
</html>
