{
	"name": "@triooo/named-routes",
	"version": "2.2.0",
	"description": "The type-safe toolkit for routes, URLs and assets in Next.js, Nuxt, Vue, SvelteKit, Astro, React Router and TanStack Router",
	"keywords": [
		"named-routes",
		"typescript",
		"nextjs",
		"app-router",
		"pages-router",
		"nuxt",
		"vue",
		"vue-router",
		"sveltekit",
		"astro",
		"react-router",
		"remix",
		"tanstack-router",
		"vite-plugin",
		"i18n",
		"next-intl",
		"laravel",
		"triooo"
	],
	"license": "Apache-2.0",
	"author": "triooo",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./generator": {
			"types": "./dist/generator.d.ts",
			"import": "./dist/generator.js",
			"default": "./dist/generator.js"
		},
		"./next": {
			"types": "./dist/next.d.ts",
			"import": "./dist/next.js",
			"default": "./dist/next.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js",
			"default": "./dist/config.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js",
			"default": "./dist/vite.js"
		},
		"./nuxt": {
			"types": "./dist/nuxt.d.ts",
			"import": "./dist/nuxt.js",
			"default": "./dist/nuxt.js"
		},
		"./astro": {
			"types": "./dist/astro.d.ts",
			"import": "./dist/astro.js",
			"default": "./dist/astro.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"named-routes": "bin/named-routes.js",
		"named-routes-mcp": "bin/named-routes-mcp.js"
	},
	"files": [
		"bin",
		"dist",
		"src",
		"README.md",
		"README.pt-BR.md",
		"README.ja.md",
		"README.es.md",
		"docs/*/*.md",
		"CHANGELOG.md",
		"LICENSE",
		"SECURITY.md",
		"assets",
		"llms.txt",
		"llms-full.txt",
		"llms-agent.md",
		"mcp/README.md",
		"mcp/bin",
		"mcp/src",
		"mcp/catalog.json",
		"CHANGELOG.pt-BR.md",
		"CHANGELOG.es.md",
		"CHANGELOG.ja.md"
	],
	"scripts": {
		"ci:local": "python scripts/ci-local.py",
		"ci:types": "python scripts/ci-local.py --only types",
		"ci:website": "python scripts/ci-local.py --only website",
		"test": "npm run build && node --test tests/*.test.mjs",
		"test:types": "tsc --project tests/tsconfig.json && tsc --project tests/tsconfig.runtime.json && tsc --project tests/tsconfig.schemas.json && node tests/docs-samples.mjs",
		"check": "npm run lint && npm test && npm run test:types",
		"test:next": "node tests/next-smoke.mjs && node tests/next-typed-routes.mjs",
		"build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/ensure-cli.mjs",
		"prepack": "npm run build && node mcp/scripts/verify-pack.mjs",
		"prepare": "npm run build",
		"website": "npm run dev --prefix website",
		"prepublishOnly": "npm test && npm run test:types && npm run test:package",
		"test:package": "npm run test:mcp && node tests/pack-smoke.mjs",
		"release:check": "npm run check && npm run test:next && npm run test:vite && npm run test:package && npm run lockfiles:fix && npm run test:e2e",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test:vite": "node tests/vite-smoke.mjs",
		"docs": "python scripts/sync-docs.py && python scripts/sync-changelog.py",
		"docs:check": "python scripts/sync-docs.py --check && python scripts/sync-changelog.py --check",
		"locales": "node scripts/sync-locales.mjs",
		"locales:check": "node scripts/sync-locales.mjs --check",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test:e2e": "node tests/e2e/run.mjs",
		"bench:watch": "node scripts/bench-watch.mjs",
		"llms": "python scripts/sync-llms.py",
		"llms:check": "python scripts/sync-llms.py --check",
		"test:mcp": "node --test mcp/tests/*.test.mjs",
		"changelog": "python scripts/sync-changelog.py",
		"changelog:prepare": "python scripts/sync-changelog.py --prepare",
		"changelog:check": "python scripts/sync-changelog.py --check",
		"lockfiles:check": "python scripts/check-lockfiles.py",
		"lockfiles:fix": "python scripts/check-lockfiles.py --fix"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.6.9",
		"@types/node": "^26.6.6",
		"playwright": "1.65.1",
		"publint": "0.3.25",
		"typescript": "^7.0.2",
		"valibot": "^1.5.0",
		"@modelcontextprotocol/client": "^2.3.0"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "pnpm@12.18.0",
	"dependencies": {
		"@babel/parser": "^7.26.0"
	},
	"optionalDependencies": {
		"@modelcontextprotocol/server": "^2.3.0",
		"named-routes-mcp-typescript": "npm:typescript@^5.9.3",
		"zod": "^4.6.7"
	}
}
